{
  "expo": {
    "name": "Pluri French",
    "slug": "conjugately",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "conjugately",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "appStoreUrl": "https://apps.apple.com/app/id6799402337",
      "supportsTablet": false,
      "bundleIdentifier": "com.conjugately.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Pluri French does not access your photo library. This description is required because a component included in the app references the photo library API."
      }
    },
    "android": {
      "package": "com.conjugately.app",
      "adaptiveIcon": {
        "backgroundColor": "#17162B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#17162B",
          "dark": {
            "backgroundColor": "#17162B"
          }
        }
      ],
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/dancing-script/600SemiBold/DancingScript_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/michroma/400Regular/Michroma_400Regular.ttf"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Pluri French uses the microphone so you can speak your answers in Masters Mic and reply out loud in the Final conversations.",
          "speechRecognitionPermission": "Pluri French uses speech recognition to check the French you speak. It runs on your iPhone when French is available offline; otherwise Apple's speech service is used. Pluri French does not record or keep your audio."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8532aabd-2434-49e0-8f31-978683c0f547"
      }
    }
  }
}
