{
  "expo": {
    "name": "Conjugately",
    "slug": "conjugately",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "conjugately",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.conjugately.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Conjugately does not access your photo library. This description is required because a component included in the app references the photo library API."
      }
    },
    "android": {
      "package": "com.conjugately.app",
      "adaptiveIcon": {
        "backgroundColor": "#1e1b4b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e1b4b",
          "dark": {
            "backgroundColor": "#1e1b4b"
          }
        }
      ],
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Conjugately uses the microphone so you can speak your answers aloud in Masters Mic instead of tapping them.",
          "speechRecognitionPermission": "Conjugately uses speech recognition to check the French conjugation you speak. Recognition runs on this iPhone and your audio is not sent anywhere."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8532aabd-2434-49e0-8f31-978683c0f547"
      }
    }
  }
}
